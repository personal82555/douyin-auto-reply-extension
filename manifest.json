{
  "manifest_version": 3,
  "name": "抖音评论辅助工具",
  "version": "1.10.9",
  "description": "抖音网页版评论辅助：搜索热门视频，AI生成候选评论文案，一键填入评论框由你审阅后发送；支持关键词筛选与评论记录统计。",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音自动回复助手"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
